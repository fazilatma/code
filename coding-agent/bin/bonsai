#!/usr/bin/env python3
"""CLI entry for BONSAI when PHP is not installed."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from serve import handle_chat  # noqa: E402


def main() -> None:
    prompt = " ".join(sys.argv[1:]).strip()
    if not prompt:
        prompt = "Given two binary strings `a` and `b`, return their sum as a binary string."
    print(f"BONSAI  ·  {prompt}\n" + "─" * 56, file=sys.stderr)

    def emit(ev: dict) -> None:
        t = ev.get("type")
        if t == "session":
            print(f"session {ev.get('id')}", file=sys.stderr)
        elif t == "thinking":
            sys.stderr.write(ev.get("delta") or "")
            sys.stderr.flush()
        elif t == "content":
            sys.stdout.write(ev.get("delta") or "")
            sys.stdout.flush()
        elif t == "tool_start":
            print(f"\n▸ {ev.get('name')} {ev.get('args')}", file=sys.stderr)
        elif t == "tool_end":
            mark = "✓" if ev.get("ok") else "✗"
            print(f"{mark} {(ev.get('output') or '')[:400]}", file=sys.stderr)
        elif t == "error":
            print(f"\nERROR: {ev.get('message')}", file=sys.stderr)
        elif t == "done":
            print("\n" + "─" * 56, file=sys.stderr)

    handle_chat(prompt, None, emit)


if __name__ == "__main__":
    main()
